! =====================================================================
! | Parameters for Gaspar et al. (1990)'s TKE vertical mixing scheme |
! =====================================================================
!
&GGL90_PARM01
 GGL90TKEmin          = 1.0e-6,
 GGL90TKEsurfMin      = 1.0e-4,
 GGL90TKEbottom       = 1.0e-6
 GGL90viscMax         = 1.0e-1,
 GGL90diffMax         = 1.0e-1,
 GGL90diffTKEh        = 0.0e0,
 GGL90ck              = 0.1,
 GGL90ceps            = 0.7,
 GGL90alpha           = 1.0,
 GGL90m2              = 3.75,
 GGL90mixingLengthMin = 1.0e-3
 mxlMaxFlag           = 2,
 calcMeanVertShear    = .true.,
 GGL90_dirichlet      = .true.,
 GGL90writeState      = .true.,
/
